{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "curiosityfields.com"
        }
      ],
      "destination": "https://www.curiosityfields.com/:path*",
      "permanent": true
    },
    {
      "source": "/category/:slug",
      "destination": "/categories/:slug",
      "permanent": true
    },
    {
      "source": "/article/ai-safety-disclosure-gap-model-releases",
      "destination": "/article/ai-model-safety-reports-disclosure-gap-explained",
      "permanent": true
    },
    {
      "source": "/article/basal-ganglia-damage-strategic-learning",
      "destination": "/article/basal-ganglia-damage-strategic-thinking-brain-study",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
